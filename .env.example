# cm-monitor — secretos. NO se sube a git (.gitignore lo excluye).
# Copia este archivo como .env y llena los valores. Claude no necesita verlos.

# Telegram: crea el bot con @BotFather (/newbot) y pega aqui el token.
TELEGRAM_BOT_TOKEN=

# Tu chat id: escribe cualquier cosa a tu bot y abre
# https://api.telegram.org/bot<TU_TOKEN>/getUpdates  -> copia result[0].message.chat.id
TELEGRAM_CHAT_ID=

# ─── Cuenta de prueba (opcional) ───────────────────────────────────────────────
# Solo hace falta para las revisiones que necesitan sesion (saber que sorteo esta
# abierto y hasta cuando se vende). Usa una cuenta DEDICADA, con saldo cero y sin
# metodo de pago. Estas variables NUNCA deben ponerse en el repositorio publico:
# van en tu .env local y en los secretos del repositorio privado.
CM_USUARIO_PRUEBA=
CM_PASSWORD_PRUEBA=
